# Copy this file to server/.env and fill in real values before running
# `node server.js` locally. This file itself has no secrets in it and
# is safe to keep in the repo; server/.env is already in .gitignore.

PORT=4000

# Set to false for local testing so the backend never checks a license
# key on /api/calculate-signal. Matches LOCAL_TEST_MODE=true in the
# extension's config.js - keep both in sync.
REQUIRE_LICENSE=false

# Leave MONGODB_URI empty to fall back to local JSON file storage in
# server/data/ (fine for local testing). Fill it in only if you want
# this local instance to share the same database as production.
MONGODB_URI=
MONGODB_DB=

# Only needed if you're also running the admin dashboard locally.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_PATH=admin
SESSION_SECRET=

DATA_DIR=./data
